# Copy this file to .env for local development. Replace every change-me value.
# Never commit .env. The defaults below are local-only and are not production credentials.
TZ=America/Costa_Rica
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
TRACKER_DB=tracker
TRACKER_DB_USER=tracker_app
TRACKER_DB_PASSWORD=change-me-tracker
N8N_DB=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=change-me-n8n-db
DATABASE_URL=postgresql://tracker_app:change-me-tracker@postgres:5432/tracker?options=-c%20TimeZone%3DUTC
API_PORT=3001
WEB_PORT=3000
N8N_PORT=5678
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_KEY=change-me-minimum-32-characters-local-only
LOCAL_TENANT_ID=00000000-0000-4000-8000-000000000001
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_AUTH_ENABLED=true
N8N_ENCRYPTION_KEY=change-me-minimum-32-characters-n8n
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-minimum-32-characters-jwt
N8N_SECURE_COOKIE=false
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_BASIC_AUTH_ACTIVE=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
EXECUTIONS_MODE=regular
IMPORTANT_EMAIL_NO_RULE_ACTION=review
N8N_WORKERS=1
REDIS_PASSWORD=change-me-redis
# Production profile only. Set to a real hostname and email before enabling.
APP_DOMAIN=tracker.example.com
ACME_EMAIL=admin@example.com
