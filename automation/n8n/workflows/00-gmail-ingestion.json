{
  "id": "10000000-0000-4000-8000-000000000000",
  "name": "00 - Gmail - Ingestion",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": true,
        "maxResults": 10,
        "filters": {
          "readStatus": "unread",
          "q": "is:unread -in:spam -in:trash",
          "includeDrafts": false
        }
      },
      "id": "00000000-0000-4000-8000-000000000001",
      "name": "Gmail Trigger - Credential Required",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        340,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_OAUTH_CREDENTIAL_REQUIRED",
          "name": "GMAIL_OAUTH_CREDENTIAL_REQUIRED"
        }
      },
      "notes": "Metadata only. Runtime sources are checked through the API before fetching content. Credential placeholder is replaced only inside encrypted n8n runtime storage."
    },
    {
      "parameters": {
        "jsCode": "return $input.all().flatMap(({json:m},index) => { const from=typeof m.From==='string'?m.From:typeof m.from==='string'?m.from:''; const match=from.match(/^(?:[^<>]*)<([^<>]+)>$/); const sender=(match?.[1] ?? from).trim().toLowerCase(); if(sender.length>320 || !/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9][a-z0-9.-]*\\.[a-z]{2,63}$/.test(sender) || typeof m.id!=='string' || !/^[a-zA-Z0-9_-]{1,128}$/.test(m.id))return []; return [{json:{tenantId:$env.LOCAL_TENANT_ID,messageId:m.id,sender,correlationId:m.id},pairedItem:{item:index}}]; });"
      },
      "id": "00000000-0000-4000-8000-000000000002",
      "name": "Keep minimum sender metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_INTERNAL_URL + ('/internal/v1/email-sources/match?tenantId=' + encodeURIComponent($json.tenantId) + '&mode=automatic&sender=' + encodeURIComponent($json.sender)) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-api-key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "x-tenant-id",
              "value": "={{ $json.tenantId ?? $json.run?.tenantId ?? $('Validate run identifiers').first().json.tenantId }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $json.correlationId ?? $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "00000000-0000-4000-8000-000000000003",
      "name": "Match enabled automatic source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().flatMap((item,index) => item.json.source ? [{json:{tenantId:item.json.source.tenantId,messageId:$('Keep minimum sender metadata').all()[index].json.messageId},pairedItem:{item:index}}] : []);"
      },
      "id": "00000000-0000-4000-8000-000000000004",
      "name": "Discard unconfigured senders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + encodeURIComponent($json.messageId) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "full"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "00000000-0000-4000-8000-000000000005",
      "name": "Retrieve full Gmail message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_OAUTH_CREDENTIAL_REQUIRED",
          "name": "GMAIL_OAUTH_CREDENTIAL_REQUIRED"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "notes": "Read-only Gmail GET. No modify/mark-read operation and no attachment fetch."
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({json:r}) => {if(r.statusCode!==200 || !r.body?.id) throw new Error('GMAIL_READ_FAILED'); return {json:{tenantId:$env.LOCAL_TENANT_ID,mode:'automatic',message:r.body}};});"
      },
      "id": "00000000-0000-4000-8000-000000000006",
      "name": "Prepare transient connector envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "10000000-0000-4000-8000-000000000001",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "00000000-0000-4000-8000-000000000007",
      "name": "Execute email router",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1660,
        300
      ]
    }
  ],
