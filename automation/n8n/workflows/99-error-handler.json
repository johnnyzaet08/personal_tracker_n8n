{
  "id": "10000000-0000-4000-8000-000000000099",
  "name": "99 - Error Handler",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "99000000-0000-4000-8000-000000000001",
      "name": "Workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const execution=$json.execution ?? {};return [{json:{schemaVersion:1,tenantId:$env.LOCAL_TENANT_ID,actionType:'n8n.workflow.error',idempotencyKey:'n8n-error:'+String(execution.id ?? $execution.id),status:'failed',input:{workflowId:String($json.workflow?.id ?? ''),executionId:String(execution.id ?? ''),errorCode:'WORKFLOW_EXECUTION_FAILED'}}}];"
      },
      "id": "99000000-0000-4000-8000-000000000002",
      "name": "Sanitize failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL + '/internal/v1/action-runs' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-api-key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $json.idempotencyKey }}"
            },
            {
              "name": "x-tenant-id",
              "value": "={{ $env.LOCAL_TENANT_ID }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "99000000-0000-4000-8000-000000000003",
      "name": "Record sanitized action run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        670,
        300
      ],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Workflow error": {
      "main": [
        [
          {
            "node": "Sanitize failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sanitize failure": {
      "main": [
        [
          {
            "node": "Record sanitized action run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "versionId": "99000000-0000-4000-8000-000000000099",
  "tags": []
}
