{
  "id": "10000000-0000-4000-8000-000000000005",
  "name": "05 - Local - Email Fixture Ingestion",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-fixture",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "05000000-0000-4000-8000-000000000001",
      "name": "Normalized fixture webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        120,
        300
      ],
      "webhookId": "local-email-fixture"
    },
    {
      "parameters": {
        "jsCode": "const e = $json.body ?? $json;\nconst required = ['schemaVersion','eventId','tenantId','source','externalId','occurredAt','receivedAt','sender'];\nfor (const key of required) if (e[key] === undefined || e[key] === null || e[key] === '') throw new Error('Invalid EmailSourceEvent fixture: missing ' + key);\nif (e.schemaVersion !== 1 || !['email_fixture','email_forward'].includes(e.source)) throw new Error('Fixture source must be email_fixture or email_forward');\nif (!e.sender?.address || !String(e.sender.address).includes('@')) throw new Error('Invalid sender address');\nreturn [{ json: e }];"
      },
      "id": "05000000-0000-4000-8000-000000000002",
      "name": "Validate shared contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        370,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL + '/internal/v1/source-events' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-api-key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "x-tenant-id",
              "value": "={{ $json.tenantId }}"
            },
            {
              "name": "x-correlation-id",
              "value": "={{ $json.eventId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "05000000-0000-4000-8000-000000000003",
      "name": "Ingest fixture event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        610,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "if ($json.statusCode && $json.statusCode >= 400) throw new Error('Fixture ingestion failed with HTTP ' + $json.statusCode);\nreturn [{ json: $('Validate shared contract').item.json }];"
      },
      "id": "05000000-0000-4000-8000-000000000004",
      "name": "Restore normalized event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "10000000-0000-4000-8000-000000000001",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "05000000-0000-4000-8000-000000000005",
      "name": "Execute same email router",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1090,
        300
      ]
    }
  ],
  "connections": {
    "Normalized fixture webhook": {
      "main": [
        [
          {
            "node": "Validate shared contract",
