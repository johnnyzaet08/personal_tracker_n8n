{
  "id": "10000000-0000-4000-8000-000000000010",
  "name": "10 - Finance - Process Candidate",
  "active": false,
  "nodes": [
    {
      "parameters": { "workflowInputs": { "values": [] } },
      "id": "10000000-1000-4000-8000-000000000001",
      "name": "Financial source event",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "jsCode": "const event = $json;\nconst adapter = event.metadata?.bankAdapter;\nreturn [{ json: { ...event, adapterAvailable: Boolean(adapter?.name && adapter?.version && event.metadata?.transactionCandidate), adapter } }];"
      },
      "id": "10000000-1000-4000-8000-000000000002",
      "name": "Resolve bank adapter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [410, 300],
      "notes": "BANK_EMAIL_FIXTURES_REQUIRED: no bank-specific parser or regex is implemented without representative fixtures."
    },
    {
      "parameters": { "conditions": { "boolean": [{ "value1": "={{ $json.adapterAvailable }}", "value2": true }] } },
      "id": "10000000-1000-4000-8000-000000000003",
      "name": "Compatible adapter found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const event = $json;\nconst c = event.metadata.transactionCandidate;\nconst required = ['candidateId','direction','transactionType','amount','currency','description','occurredAt'];\nfor (const key of required) if (c[key] === undefined || c[key] === '') throw new Error('Invalid FinancialTransactionCandidate: missing ' + key);\nif (!['debit','credit'].includes(c.direction)) throw new Error('Invalid transaction direction');\nif (!/^[A-Z]{3}$/.test(c.currency)) throw new Error('Invalid currency');\nreturn [{ json: { schemaVersion: 1, ...c, tenantId: event.tenantId, sourceEventId: event.eventId ?? event.id, requiresReview: c.requiresReview ?? false, rawMetadata: c.rawMetadata ?? {}, adapter: event.adapter } }];"
      },
      "id": "10000000-1000-4000-8000-000000000004",
      "name": "Validate transaction candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 210]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL + '/internal/v1/finance/transactions' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-internal-api-key", "value": "={{ $env.INTERNAL_API_KEY }}" },
          { "name": "x-tenant-id", "value": "={{ $json.tenantId }}" },
          { "name": "x-correlation-id", "value": "={{ $json.sourceEventId }}" }
        ] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 10000 }
      },
      "id": "10000000-1000-4000-8000-000000000005",
      "name": "Persist transaction candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 210]
    },
    {
      "parameters": { "jsCode": "return [{ json: { ...$json, reviewReason: 'BANK_ADAPTER_NOT_AVAILABLE', priority: 'normal' } }];" },
      "id": "10000000-1000-4000-8000-000000000006",
      "name": "Prepare adapter review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 410]
    },
    {
      "parameters": { "workflowId": { "__rl": true, "value": "10000000-0000-4000-8000-000000000090", "mode": "id" }, "options": { "waitForSubWorkflow": true } },
      "id": "10000000-1000-4000-8000-000000000007",
      "name": "Send to review queue",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [1160, 410]
    }
  ],
  "connections": {
    "Financial source event": { "main": [[{ "node": "Resolve bank adapter", "type": "main", "index": 0 }]] },
    "Resolve bank adapter": { "main": [[{ "node": "Compatible adapter found?", "type": "main", "index": 0 }]] },
    "Compatible adapter found?": { "main": [[{ "node": "Validate transaction candidate", "type": "main", "index": 0 }], [{ "node": "Prepare adapter review", "type": "main", "index": 0 }]] },
    "Validate transaction candidate": { "main": [[{ "node": "Persist transaction candidate", "type": "main", "index": 0 }]] },
    "Prepare adapter review": { "main": [[{ "node": "Send to review queue", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "10000000-0000-4000-8000-000000000099" },
  "versionId": "10000000-1000-4000-8000-000000000099",
  "tags": []
}
