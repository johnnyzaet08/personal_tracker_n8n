generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["automation", "core", "finance", "habits", "health"]
}

model Tenant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique @db.VarChar(80)
  name            String   @db.VarChar(160)
  timezone        String   @default("UTC") @db.VarChar(64)
  defaultCurrency String   @map("default_currency") @db.Char(3)
  status          String   @default("active") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    TenantMembership[]
  integrations   Integration[]
  sourceEvents   SourceEvent[]
  accounts       Account[]
  merchants      Merchant[]
  categories     Category[]
  transactions   Transaction[]
  recurring      RecurringPayment[]
  reviewItems    ReviewQueue[]
  notifications  Notification[]

  @@map("tenants")
  @@schema("core")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.VarChar(320)
  name      String?  @db.VarChar(160)
  status    String   @default("active") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships TenantMembership[]
  assignedReviews ReviewQueue[] @relation("ReviewAssignee")

  @@map("users")
  @@schema("core")
}

model TenantMembership {
  tenantId String   @map("tenant_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
  @@schema("core")
}

model Integration {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  provider           String    @db.VarChar(64)
  type               String    @db.VarChar(64)
  status             String    @default("disconnected") @db.VarChar(32)
  externalAccountRef String?   @map("external_account_ref") @db.VarChar(255)
  metadata           Json      @default("{}") @db.JsonB
  lastSyncAt         DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, type])
  @@index([tenantId, status])
  @@map("integrations")
  @@schema("core")
}

model SourceEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  source        String   @db.VarChar(64)
  externalId    String   @map("external_id") @db.VarChar(512)
  eventType     String   @map("event_type") @db.VarChar(128)
  schemaVersion Int      @map("schema_version")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt    DateTime @map("received_at") @db.Timestamptz(6)
  status        String   @default("received") @db.VarChar(32)
  payload       Json     @db.JsonB
  payloadHash   String   @map("payload_hash") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions    Transaction[]
  classifications Classification[]
  actionRuns      ActionRun[]
  reviewItems     ReviewQueue[]
  notifications   Notification[]

  @@unique([tenantId, source, externalId])
  @@index([tenantId, source, occurredAt(sort: Desc)])
  @@index([tenantId, status, receivedAt(sort: Desc)])
  @@index([payloadHash])
  @@map("source_events")
  @@schema("core")
}

model Account {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  institutionName  String   @map("institution_name") @db.VarChar(160)
  alias             String   @db.VarChar(160)
  accountType       String   @map("account_type") @db.VarChar(64)
  maskedIdentifier String?  @map("masked_identifier") @db.VarChar(32)
  currency          String   @db.Char(3)
  status            String   @default("active") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringPayment[]

  @@unique([tenantId, institutionName, maskedIdentifier])
  @@index([tenantId, status])
  @@map("accounts")
  @@schema("finance")
}

model Merchant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  canonicalName String   @map("canonical_name") @db.VarChar(255)
  displayName   String   @map("display_name") @db.VarChar(255)
  metadata      Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringPayment[]

  @@unique([tenantId, canonicalName])
  @@index([tenantId, displayName])
  @@map("merchants")
  @@schema("finance")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(160)
  slug      String   @db.VarChar(160)
  type      String   @db.VarChar(32)
  color     String?  @db.VarChar(16)
  icon      String?  @db.VarChar(64)
  status    String   @default("active") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId, status])
  @@map("categories")
  @@schema("finance")
}

model Transaction {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  sourceEventId     String    @map("source_event_id") @db.Uuid
  accountId         String?   @map("account_id") @db.Uuid
  merchantId        String?   @map("merchant_id") @db.Uuid
  categoryId        String?   @map("category_id") @db.Uuid
  externalReference String?   @map("external_reference") @db.VarChar(512)
  direction         String    @db.VarChar(16)
  transactionType   String    @map("transaction_type") @db.VarChar(64)
  amount            Decimal   @db.Decimal(20, 4)
  currency          String    @db.Char(3)
  description       String    @db.VarChar(1000)
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz(6)
  postedAt          DateTime? @map("posted_at") @db.Timestamptz(6)
  confidence        Decimal?  @db.Decimal(5, 4)
  requiresReview    Boolean   @default(false) @map("requires_review")
  status            String    @default("pending") @db.VarChar(32)
  rawMetadata       Json      @default("{}") @map("raw_metadata") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceEvent SourceEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  merchant    Merchant?   @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, status, occurredAt(sort: Desc)])
  @@index([tenantId, accountId, occurredAt(sort: Desc)])
  @@index([tenantId, categoryId, occurredAt(sort: Desc)])
  @@index([tenantId, merchantId, occurredAt(sort: Desc)])
  @@index([tenantId, currency, occurredAt(sort: Desc)])
  @@index([tenantId, requiresReview, occurredAt(sort: Desc)])
  @@map("transactions")
  @@schema("finance")
}

model RecurringPayment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  accountId        String?   @map("account_id") @db.Uuid
  merchantId       String?   @map("merchant_id") @db.Uuid
  name             String    @db.VarChar(255)
  expectedAmount   Decimal?  @map("expected_amount") @db.Decimal(20, 4)
  currency         String    @db.Char(3)
  frequency        String    @db.VarChar(32)
  nextExpectedAt   DateTime? @map("next_expected_at") @db.Timestamptz(6)
  lastChargedAt    DateTime? @map("last_charged_at") @db.Timestamptz(6)
  status           String    @default("active") @db.VarChar(32)
  metadata         Json      @default("{}") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name, accountId])
  @@index([tenantId, status, nextExpectedAt])
  @@map("recurring_payments")
  @@schema("finance")
}

model Classification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceEventId     String   @map("source_event_id") @db.Uuid
  classifier        String   @db.VarChar(128)
  classifierVersion String   @map("classifier_version") @db.VarChar(64)
  labels            Json     @db.JsonB
  confidence        Decimal? @db.Decimal(5, 4)
  decisionReason    String?  @map("decision_reason") @db.VarChar(1000)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceEvent SourceEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, classifier, classifierVersion])
  @@map("classifications")
  @@schema("automation")
}

model ActionRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceEventId  String?   @map("source_event_id") @db.Uuid
  actionType     String    @map("action_type") @db.VarChar(128)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(32)
  attemptCount   Int       @default(0) @map("attempt_count")
  input          Json      @default("{}") @db.JsonB
  output         Json?     @db.JsonB
  errorCode      String?   @map("error_code") @db.VarChar(128)
  errorMessage   String?   @map("error_message") @db.VarChar(1000)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceEvent SourceEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([sourceEventId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("action_runs")
  @@schema("automation")
}

model ReviewQueue {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  sourceEventId String    @map("source_event_id") @db.Uuid
  reason        String    @db.VarChar(1000)
  priority      String    @default("normal") @db.VarChar(16)
  status        String    @default("pending") @db.VarChar(32)
  assignedTo    String?   @map("assigned_to") @db.Uuid
  resolution    Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceEvent SourceEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("ReviewAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceEventId])
  @@index([tenantId, status, priority, createdAt(sort: Desc)])
  @@map("review_queue")
  @@schema("automation")
}

model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  sourceEventId    String?   @map("source_event_id") @db.Uuid
  channel          String    @db.VarChar(64)
  notificationType String    @map("notification_type") @db.VarChar(128)
  status           String    @default("pending") @db.VarChar(32)
  scheduledAt      DateTime? @map("scheduled_at") @db.Timestamptz(6)
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  metadata         Json      @default("{}") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceEvent SourceEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, scheduledAt])
  @@map("notifications")
  @@schema("automation")
}
